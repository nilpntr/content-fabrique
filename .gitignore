.env
.env.local
.env.*
!.env.example

# Wrangler / the Cloudflare Vite plugin read local Worker secrets from .dev.vars (and .dev.vars.<env>).
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*

apps/web/node_modules
apps/web/.output
apps/web/.nitro
apps/web/.tanstack
apps/web/dist
apps/web/.env
apps/web/.env.local

server/bin
server/tmp
server/data/
server/coverage.out
*.exe

/node_modules
packages/*/node_modules

# Go test binaries (go test -c)
*.test

.claude/worktrees/

# Local dev binaries built by `task dev`
/.dev/

# Built binaries
/apps/server/cfctl
/apps/server/api
/apps/server/worker

# Media the render golden tests generate (apps/server/internal/render)
apps/server/internal/render/testdata/.cache/

# Eval results and the local ids of the eval suites (D-39): a creator's ids, renders and scores stay on this machine
/eval-results/
/apps/server/eval-results/
suites/*.local.yaml
