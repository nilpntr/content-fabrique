{
  "name": "@cf/schemas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JSON Schemas shared by the Go server and the web app: the timeline spec v1, its fixtures and the generated TypeScript types.",
  "scripts": {
    "gen": "bun scripts/gen.ts",
    "gen:check": "sh scripts/gen-check.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
