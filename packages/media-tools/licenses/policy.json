      "--enable-zlib",
      "--enable-iconv",
      "--enable-libx264",
      "--enable-libdav1d",
      "--enable-libzimg",
      "--enable-libass",
      "--enable-libfreetype",
      "--enable-libfontconfig",
      "--enable-libharfbuzz"
    ]
