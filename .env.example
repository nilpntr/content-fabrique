# Content Fabrique: every variable the stack reads.
#
# HOW TO USE
#   cp .env.example .env          (`.env` is gitignored: never commit real values)
#   Fill in only the lines tagged [YOU-now]. That is three values.
#   Lines tagged [AUTO] already work locally or are generated by the agent (`task env:init`).
#   The other [YOU-...] lines wait until their phase. Create those accounts when you get there.
#   Check the result with:  cfctl doctor --env local
#
# TAGS
#   [YOU-now]      you provide it before the agent starts
#   [YOU-staging]  you provide it when staging is set up (P0-09, P0-10)
#   [YOU-P6] [YOU-P7]   later phases (TikTok, billing)
#   [AUTO]         local default, or generated by the agent: leave as is
#   [optional]     only if you use that feature
#   [public]       safe to ship to the browser. Only [public] values may use the VITE_ prefix
#
# SCOPES
#   Every token below says what to grant it. Grant nothing extra. The same list as a table, with where to click:
#   docs/06-setup-and-credentials.md §3.9
#
# The names are the same in every environment (local, ci, bench, staging, production), the values differ.
# Staging and production values go in `.env.staging` and `.env.production` on your machine (also gitignored)
# and in the GitHub environment secrets, never in git.

# ══ 1. START HERE: the three values only you can create ═══════════════════════
# Anthropic Console → Workspaces → "dev" → API keys. Anthropic keys have no scopes, so the workspace is the limit:
# one key per environment and a $50 monthly spend limit on "dev". Never an Admin key.
ANTHROPIC_API_KEY=                             # [YOU-now]
# Clerk dashboard → API keys, development instance. The publishable key is public and has no scopes.
VITE_CLERK_PUBLISHABLE_KEY=                    # [YOU-now] [public] pk_test_...
# Same page, the secret key. No scopes can be set: it has full Backend API access to the instance, and it is also what the
# Go API uses to verify requests, so there is no separate API secret. Server only, never a VITE_ variable.
CLERK_SECRET_KEY=                              # [YOU-now] sk_test_...

# ══ 2. LOCAL DEFAULTS: leave as they are ══════════════════════════════════════
CF_ENV=local                                   # [AUTO] local | ci | bench | staging | production
# Staging: https://staging.contentfabrique.app and https://api-staging.contentfabrique.app. Production: https://contentfabrique.app and https://api.contentfabrique.app
APP_BASE_URL=http://localhost:3000             # [AUTO] [public]
API_BASE_URL=http://localhost:8080             # [AUTO] [public]
VITE_API_BASE_URL=http://localhost:8080        # [AUTO] [public]
# Model names: the native Anthropic path (direct, or the gateway's /anthropic endpoint) takes claude-opus-5-5. Cloudflare's REST
# endpoints name the same model anthropic/claude-opus-5.5. config/routing/models.yaml holds both, so you never type either here.
ROUTING_PROFILE=dev-cheap                      # [AUTO] dev-cheap | dev-mid | v1-start. Start cheap and climb (decision D-22)
LLM_MODE=live                                  # [AUTO] live | record | replay. Replay makes tests cost nothing
ANTHROPIC_BASE_URL=                            # [AUTO] empty = call api.anthropic.com directly (the bypass, and how you start). Once the gateways exist every environment sets its gateway URL: cf-dev for local, CI and bench
# Model spend caps and limits (P4-00a). Money is in micro-dollars: 1,000,000 = $1. Every cap is checked before a request is sent.
LLM_MAX_REQUEST_MICROS=2000000                 # [AUTO] refuse any single call whose worst case (counted input tokens plus max_tokens of output, at list price) is above this. Default $2
DAILY_SPEND_CAP_MICROS=20000000                # [AUTO] per workspace per UTC day, summed from usage_ledger. Default $20. Raise it in staging and production only on purpose
LLM_KEY_CONCURRENCY=4                          # [AUTO] requests in flight per API key. More callers wait in a queue; 429 and 529 back off and retry here, nowhere else
LLM_ALLOW_UNPRICED=                            # [optional] 1 = call a model that has no price in config/pricing (ledger cost 0, caps cannot be checked). Empty refuses it
LLM_CASSETTE_DIR=                              # [optional] where LLM_MODE=record|replay keep cassettes. Empty = testdata/cassettes (relative to where the tests run)

# Postgres. Local: docker compose. Staging and production (PlanetScale): the app role has DML only (SELECT, INSERT, UPDATE,
# DELETE on the app tables, USAGE on sequences). No DDL, no superuser.
DATABASE_URL=postgres://cf:cf@localhost:5432/cf?sslmode=disable          # [AUTO] pooled, for request traffic
DATABASE_DIRECT_URL=postgres://cf:cf@localhost:5432/cf?sslmode=disable   # [AUTO] direct, same app role: LISTEN/NOTIFY
# A separate role that owns the schema, so it can create, alter and drop. Used only by `cfctl migrate` (`task migrate`) in the release
# step, never on an app server. Use a direct connection, not the pooled one. Each migration grants the database's group role
# (<database>_app, cf_app locally) its rights on the new tables, and the app role is a member of it (docs/06 section 3.4).
DATABASE_MIGRATE_URL=postgres://cf:cf@localhost:5432/cf?sslmode=disable # [AUTO] local: the same database
POSTGRES_USER=cf                               # [AUTO] docker compose only
POSTGRES_PASSWORD=cf                           # [AUTO] docker compose only
POSTGRES_DB=cf                                 # [AUTO] docker compose only

# Object storage. Local: MinIO stands in for R2. Staging and production: Cloudflare → R2 object storage → Account Details → API Tokens
# → Manage → Create Account API token → Object Read & Write, applied to that environment's bucket only (never Admin). The secret
# is shown once.
R2_ENDPOINT=http://localhost:9000              # [AUTO] staging and production: https://<CLOUDFLARE_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_BUCKET=cf-media-dev                         # [AUTO] cf-media-staging and cf-media-production in the cloud
R2_ACCESS_KEY_ID=minioadmin                    # [AUTO]
R2_SECRET_ACCESS_KEY=minioadmin                # [AUTO]
R2_JURISDICTION=                               # [AUTO] empty for MinIO. "eu" for real R2

# Media pipeline (P1-04). The worker runs ffmpeg and ffprobe on every uploaded file inside a sandbox, never on the host
# (decision D-08). Build the image once: docker build -t media-tools:dev packages/media-tools
MEDIA_SANDBOX_PROVIDER=docker                  # [AUTO] docker | hardened | local. Empty = docker, and hardened (docker under gVisor) when CF_ENV is staging or production. local isolates nothing and is refused in staging and production
MEDIA_TOOLS_IMAGE=media-tools:dev              # [AUTO] the media-tools image; never pulled at job time
MEDIA_TEMP_DIR=                                # [AUTO] an absolute directory for the job files and the sandbox's mounts. Empty = <system temp dir>/cf-media
MEDIA_CONCURRENCY=2                            # [AUTO] ingests that run at once on one worker (1 to 32)
RENDER_CONCURRENCY=2                           # [AUTO] renders that run at once on one worker (1 to 32); they have a queue of their own, so an ingest never holds up a preview

# Transcription (P2-05, decision D-27). Local, ci and bench run whisper.cpp in the same media-tools sandbox; staging and production
# call Workers AI (section 3). The models are not in the image: the worker downloads the one it needs on first use (574 MB for
# large-v3-turbo-q5_0, 78 MB for tiny.en, 1 MB for the voice-activity model), checks its SHA-256 and keeps it in WHISPER_MODELS_DIR.
TRANSCRIBE_PROVIDER=whispercpp                 # [AUTO] whispercpp | workersai. Empty = whispercpp, and workersai when CF_ENV is staging or production
TRANSCRIBE_MODEL=large-v3-turbo-q5_0           # [AUTO] the whisper.cpp model: large-v3-turbo-q5_0 | tiny.en. Empty = large-v3-turbo-q5_0, and tiny.en when CF_ENV=ci
TRANSCRIBE_LANGUAGE=                           # [AUTO] an ISO 639-1 code such as en or nl. Empty = detect the language of each clip
TRANSCRIBE_CONCURRENCY=1                       # [AUTO] transcriptions that run at once on one worker (1 to 8); CPU heavy, with a queue of their own
WHISPER_MODELS_DIR=                            # [AUTO] an absolute directory for the downloaded models. Empty = <MEDIA_TEMP_DIR>/whisper-models

# Generated by `task env:init`, no scopes: random bytes, different in every environment.
# SECRETS_MASTER_KEY: openssl rand -base64 32. Back it up, because losing it makes stored customer API keys unreadable.
SECRETS_MASTER_KEY=                            # [AUTO]
SECRETS_MASTER_KEY_VERSION=1                   # [AUTO]
SANDBOX_GATEWAY_URL=http://localhost:8787      # [AUTO] the sandbox gateway Worker under `wrangler dev`
SANDBOX_GATEWAY_TOKEN=                         # [AUTO] openssl rand -hex 32, shared by the Go service and the Worker
RIVER_UI_PASSWORD=                             # [AUTO] openssl rand -hex 16, staging only

# ══ 3. STAGING AND DEPLOY (P0-09, P0-10) ══════════════════════════════════════
# Not a secret: dashboard → Workers & Pages → Account ID.
CLOUDFLARE_ACCOUNT_ID=                         # [YOU-staging]
# Not a secret: contentfabrique.app → Overview → API → Zone ID.
CLOUDFLARE_ZONE_ID=                            # [YOU-staging]
# Cloudflare → Manage account → Account API tokens → Create token (custom). Grant exactly:
#   Account: Workers Scripts Edit, Workers R2 Storage Edit, AI Gateway Read, AI Gateway Edit, Cloudflare Tunnel Edit,
#            Containers Edit, Account Settings Read
#   Zone (contentfabrique.app only): Zone Read, DNS Edit, Workers Routes Edit
# Not Workers KV Storage Edit, because nothing uses KV: add it only if a Worker later needs a cache. This token cannot create
# other tokens, on purpose. Set a 90-day expiry. Your machine and CI only, never on a server.
CLOUDFLARE_API_TOKEN=                          # [YOU-staging]
# Created by `cfctl bootstrap`. No scopes: it lets one cloudflared connector run one tunnel. Goes to the server, not your machine.
CLOUDFLARE_TUNNEL_TOKEN=                       # [YOU-staging]
# Gateway slug: cf-dev | cf-staging | cf-production (created by `cfctl bootstrap`).
CF_AIG_GATEWAY_ID=                             # [YOU-staging]
# Cloudflare → AI → AI Gateway → the gateway → Settings → Create authentication token. It gets the Run permission and nothing else.
# Copy it when it is shown (it isn't shown again), then switch Authenticated Gateway on. It is account-scoped: it works on every
# gateway in the account, so treat it as sensitive. Native requests send it as the cf-aig-authorization header.
CF_AIG_TOKEN=                                  # [YOU-staging]
# Once the gateways exist, every environment sets ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<CLOUDFLARE_ACCOUNT_ID>/<CF_AIG_GATEWAY_ID>/anthropic
# Clerk → Webhooks → Add endpoint https://api-staging.contentfabrique.app/v1/webhooks/clerk, then copy its signing secret.
# Subscribe to: user.created, user.updated, user.deleted, organization.created, organization.updated, organization.deleted,
# organizationMembership.created, organizationMembership.updated, organizationMembership.deleted. Nothing else.
CLERK_WEBHOOK_SECRET=                          # [YOU-staging] whsec_...
# Transcription on Workers AI (P2-05, D-27): the model @cf/openai/whisper-large-v3-turbo. Set both or neither; without them the
# transcribe jobs wait. The token is a Cloudflare API token with Account → Workers AI → Read and Edit (Run) and nothing else; this is
# the account id of CLOUDFLARE_ACCOUNT_ID. Before production: check that inference can stay in the EU (D-15) and fill in the price.
WORKERS_AI_ACCOUNT_ID=                         # [YOU-staging]
WORKERS_AI_API_TOKEN=                          # [YOU-staging]
WORKERS_AI_PRICE_MICROS_PER_MINUTE=            # [YOU-staging] the verified list price of one minute of audio in millionths of a dollar. Empty = unpriced in the ledger
DEPLOY_HOST=                                   # [YOU-staging] server IP or hostname
DEPLOY_SSH_USER=                               # [YOU-staging] deploy
# ssh-keygen -t ed25519, made only for deploys. The server user is `deploy`: in the docker group, no sudo, no password login.
DEPLOY_SSH_PRIVATE_KEY=                        # [YOU-staging] CI secret
OTEL_EXPORTER_OTLP_ENDPOINT=                   # [YOU-staging] empty locally. Axiom: https://api.axiom.co (or your region's domain)
# Axiom → Settings → API tokens → New API token → Basic, with dataset access to this environment's dataset only (it can ingest
# and nothing else). Not an advanced token, not a personal token. Set an expiry.
OTEL_EXPORTER_OTLP_HEADERS=                    # [YOU-staging] Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
# Sentry DSNs only let events in. They are public by design and have no scopes.
SENTRY_DSN=                                    # [YOU-staging] Sentry project for the Go service
VITE_SENTRY_DSN=                               # [YOU-staging] [public] Sentry project for the web app

# ══ 4. LATER PHASES ═══════════════════════════════════════════════════════════
# TikTok for Developers → your app. Products: Login Kit and Content Posting API. Request the scopes user.info.basic and
# video.upload only. Not video.publish (needs TikTok's audit) and not video.list.
TIKTOK_CLIENT_KEY=                             # [YOU-P6]
TIKTOK_CLIENT_SECRET=                          # [YOU-P6]
# Production: https://contentfabrique.app/integrations/tiktok/callback. Staging: https://staging.contentfabrique.app/integrations/tiktok/callback
# TikTok may refuse a plain http://localhost redirect (unchecked). If it does, test against staging.
TIKTOK_REDIRECT_URI=http://localhost:3000/integrations/tiktok/callback   # [YOU-P6] must match the app registration

BILLING_PROVIDER=paddle                        # [YOU-P7] paddle | stripe (decision D-13). Fill in one provider's set
# Paddle API key: only customers, subscriptions and transactions (read and write), products and prices (read), notification settings (read).
PADDLE_API_KEY=                                # [YOU-P7]
# Paddle notification destination secret. Subscribe to subscription.* and transaction.completed, transaction.payment_failed.
PADDLE_WEBHOOK_SECRET=                         # [YOU-P7]
PADDLE_CLIENT_TOKEN=                           # [YOU-P7] [public]
PADDLE_ENVIRONMENT=sandbox                     # [YOU-P7] sandbox | production
# Stripe: a restricted key (rk_...), not the full secret key. Write: Customers, Checkout Sessions, Customer portal, Subscriptions.
# Read: Products, Prices, Invoices.
STRIPE_SECRET_KEY=                             # [YOU-P7]
# Stripe webhook endpoint secret. Events: checkout.session.completed, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=                         # [YOU-P7]
STRIPE_PUBLISHABLE_KEY=                        # [YOU-P7] [public]

# ══ 5. OPTIONAL ═══════════════════════════════════════════════════════════════
# Only if you call Cloudflare's REST API (model names like anthropic/claude-opus-5.5, paid from Cloudflare credits) instead of a
# provider's own endpoint. A Cloudflare API token with Account → Workers AI → Read and nothing else. A token that holds only an
# AI Gateway permission gets a 401 there, so this is not CF_AIG_TOKEN.
CF_AI_API_TOKEN=                               # [optional]
# Google AI Studio key, restricted to the Generative Language API with a quota. Or skip it and use Cloudflare credits.
GEMINI_API_KEY=                                # [optional] only for the P2 video-model spike
TWELVELABS_API_KEY=                            # [optional] only for the P2 video-model spike. No scopes offered
# ElevenLabs: restrict the key to speech-to-text if the key page offers it.
ELEVENLABS_API_KEY=                            # [optional] only if you pick ElevenLabs Scribe over the local Whisper model
CHARTMETRIC_REFRESH_TOKEN=                     # [optional] licensed music analytics, about $350 a month (P5). No scopes offered
