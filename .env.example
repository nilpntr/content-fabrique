# Content Fabrique: every variable the stack reads.
#
# HOW TO USE
#   cp .env.example .env          (`.env` is gitignored: never commit real values)
#   Fill in only the lines tagged [YOU-now]. That is three values.
#   Lines tagged [AUTO] already work locally or are generated by the agent (`task env:init`).
#   The other [YOU-...] lines wait until their phase. Create those accounts when you get there.
#   Check the result with:  cfctl doctor --env local
#
# TAGS
#   [YOU-now]      you provide it before the agent starts
#   [YOU-staging]  you provide it when staging is set up (P0-09, P0-10)
#   [YOU-P6] [YOU-P7]   later phases (TikTok, billing)
#   [AUTO]         local default, or generated by the agent: leave as is
#   [optional]     only if you use that feature
#   [public]       safe to ship to the browser. Only [public] values may use the VITE_ prefix
#
# The names are the same in every environment (local, ci, bench, staging, production), the values differ.
# Staging and production values go in `.env.staging` and `.env.production` on your machine (also gitignored)
# and in the GitHub environment secrets, never in git.
# Where each value comes from: docs/06-setup-and-credentials.md

# ══ 1. START HERE: the three values only you can create ═══════════════════════
ANTHROPIC_API_KEY=                             # [YOU-now] Anthropic Console → workspace "dev" → API keys. Give the workspace a $50 monthly limit
VITE_CLERK_PUBLISHABLE_KEY=                    # [YOU-now] [public] Clerk dashboard → API keys, development instance: pk_test_...
CLERK_SECRET_KEY=                              # [YOU-now] Clerk dashboard → API keys, development instance: sk_test_... The Go API and the web server use it. Never in the browser

# ══ 2. LOCAL DEFAULTS: leave as they are ══════════════════════════════════════
CF_ENV=local                                   # [AUTO] local | ci | bench | staging | production
APP_BASE_URL=http://localhost:3000             # [AUTO] [public]
API_BASE_URL=http://localhost:8080             # [AUTO] [public]
VITE_API_BASE_URL=http://localhost:8080        # [AUTO] [public]
ROUTING_PROFILE=dev-cheap                      # [AUTO] dev-cheap | dev-mid | v1-start. Start cheap and climb (decision D-22)
LLM_MODE=live                                  # [AUTO] live | record | replay. Replay makes tests cost nothing
ANTHROPIC_BASE_URL=                            # [AUTO] empty = call api.anthropic.com directly (the bypass, and how you start). Once the gateways exist every environment sets its gateway URL: cf-dev for local, CI and bench

DATABASE_URL=postgres://cf:cf@localhost:5432/cf?sslmode=disable          # [AUTO] docker compose Postgres, pooled in staging and production
DATABASE_DIRECT_URL=postgres://cf:cf@localhost:5432/cf?sslmode=disable   # [AUTO] direct connection: migrations and LISTEN/NOTIFY
POSTGRES_USER=cf                               # [AUTO] docker compose only
POSTGRES_PASSWORD=cf                           # [AUTO] docker compose only
POSTGRES_DB=cf                                 # [AUTO] docker compose only

R2_ENDPOINT=http://localhost:9000              # [AUTO] local MinIO stands in for R2. Staging and production: https://<CLOUDFLARE_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_BUCKET=cf-media-dev                         # [AUTO] cf-media-staging and cf-media-production in the cloud
R2_ACCESS_KEY_ID=minioadmin                    # [AUTO] staging and production: an R2 API token (Object Read & Write) scoped to the bucket
R2_SECRET_ACCESS_KEY=minioadmin                # [AUTO]
R2_JURISDICTION=                               # [AUTO] empty for MinIO. "eu" for real R2

SECRETS_MASTER_KEY=                            # [AUTO] generated by `task env:init`: openssl rand -base64 32. Encrypts customers' API keys
SECRETS_MASTER_KEY_VERSION=1                   # [AUTO]
SANDBOX_GATEWAY_URL=http://localhost:8787      # [AUTO] the sandbox gateway Worker under `wrangler dev`
SANDBOX_GATEWAY_TOKEN=                         # [AUTO] generated: openssl rand -hex 32
RIVER_UI_PASSWORD=                             # [AUTO] generated: openssl rand -hex 16

# ══ 3. STAGING AND DEPLOY (P0-09, P0-10) ══════════════════════════════════════
CLOUDFLARE_ACCOUNT_ID=                         # [YOU-staging] dashboard → Workers & Pages → Account ID
CLOUDFLARE_API_TOKEN=                          # [YOU-staging] bootstrap and deploy token (docs/06 §3.3). Your machine and CI only, never on a server
CLOUDFLARE_ZONE_ID=                            # [YOU-staging] zone of your product domain
CLOUDFLARE_TUNNEL_TOKEN=                       # [YOU-staging] created by `cfctl bootstrap`. It goes to the server, not your machine
CF_AIG_GATEWAY_ID=                             # [YOU-staging] gateway slug: cf-dev | cf-staging | cf-production (created by `cfctl bootstrap`)
CF_AIG_TOKEN=                                  # [YOU-staging] gateway authentication token (gateway → Settings → Create authentication token)
# Once the gateways exist, every environment sets ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<CLOUDFLARE_ACCOUNT_ID>/<CF_AIG_GATEWAY_ID>/anthropic
CLERK_WEBHOOK_SECRET=                          # [YOU-staging] whsec_... of the webhook endpoint (https://<api host>/v1/webhooks/clerk)
DEPLOY_HOST=                                   # [YOU-staging] server IP or hostname
DEPLOY_SSH_USER=                               # [YOU-staging]
DEPLOY_SSH_PRIVATE_KEY=                        # [YOU-staging] a new key pair made for deploys. CI secret
OTEL_EXPORTER_OTLP_ENDPOINT=                   # [YOU-staging] empty locally. Axiom: https://api.axiom.co
OTEL_EXPORTER_OTLP_HEADERS=                    # [YOU-staging] Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
SENTRY_DSN=                                    # [YOU-staging] Sentry project for the Go service
VITE_SENTRY_DSN=                               # [YOU-staging] [public] Sentry project for the web app

# ══ 4. LATER PHASES ═══════════════════════════════════════════════════════════
TIKTOK_CLIENT_KEY=                             # [YOU-P6] TikTok for Developers → your app
TIKTOK_CLIENT_SECRET=                          # [YOU-P6]
TIKTOK_REDIRECT_URI=http://localhost:3000/integrations/tiktok/callback   # [YOU-P6] must match the app registration

BILLING_PROVIDER=paddle                        # [YOU-P7] paddle | stripe (decision D-13)
PADDLE_API_KEY=                                # [YOU-P7]
PADDLE_WEBHOOK_SECRET=                         # [YOU-P7]
PADDLE_CLIENT_TOKEN=                           # [YOU-P7] [public]
PADDLE_ENVIRONMENT=sandbox                     # [YOU-P7] sandbox | production
STRIPE_SECRET_KEY=                             # [YOU-P7]
STRIPE_WEBHOOK_SECRET=                         # [YOU-P7]
STRIPE_PUBLISHABLE_KEY=                        # [YOU-P7] [public]

# ══ 5. OPTIONAL ═══════════════════════════════════════════════════════════════
OPENROUTER_API_KEY=                            # [optional] only for non-Claude models in benchmarks (D-19)
GEMINI_API_KEY=                                # [optional] only for the P2 video-model spike
TWELVELABS_API_KEY=                            # [optional] only for the P2 video-model spike
ELEVENLABS_API_KEY=                            # [optional] only if you pick ElevenLabs Scribe over the local Whisper model for transcription
CHARTMETRIC_REFRESH_TOKEN=                     # [optional] licensed music analytics, about $350 a month (P5)
