{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // routeTree.gen.ts is generated by TanStack Start on every build and is overwritten.
    "includes": ["**", "!src/routeTree.gen.ts"]
  },
  // Tailwind 4 directives (@theme, @apply, @custom-variant) in src/index.css.
  "css": { "parser": { "tailwindDirectives": true } },
  // Lint only: the codebase is not reformatted and imports are not reordered.
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  // The recommended rules are on by default; only these are switched off.
  "linter": {
    "enabled": true,
    // Set explicitly: Biome's detection from package.json did not turn the React rules on (exhaustive-deps).
    "domains": { "react": "recommended" },
    "rules": {
      "complexity": {
        // The prefers-reduced-motion reset in src/index.css has to beat every utility class.
        "noImportantStyles": "off"
      }
    }
  },
  "overrides": [
    {
      // shadcn writes `import * as React` in its components, and `shadcn add` would bring it back.
      "includes": ["src/components/ui/**"],
      "linter": { "rules": { "style": { "useImportType": "off" } } }
    }
  ]
}
